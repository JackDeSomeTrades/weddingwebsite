---
import '../styles/global.css';
import site from '../data/site.json';
import Nav from '../components/Nav.astro';
import KolamDivider from '../components/KolamDivider.astro';

interface Props {
  title: string;
  description?: string;
  current: string;
  background?: string;
  width?: 'narrow' | 'wide' | 'full';
}
const { title, description, current, background = 'floral', width = 'narrow' } = Astro.props;
const couple = `${site.partner1.en} & ${site.partner2.en}`;
const fullTitle = current === 'home' ? couple : `${title} · ${couple}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? `${couple} — ${site.dateDisplay}, ${site.city}`} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🪔</text></svg>" />
    <!-- Marks JS as available so scroll-reveal styles apply (content stays visible without JS). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Placeholder fonts: change these (and the variables in theme.css) when you pick your own -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Great+Vibes&family=Jost:wght@400;500&family=Noto+Serif+Kannada:wght@400;500;600&display=swap"
    />
  </head>
  <body data-bg={background}>
    <Nav current={current} />
    <main class={width}>
      <slot />
    </main>
    <footer>
      <KolamDivider />
      <span class="script">{couple}</span>
      {site.dateDisplay} · {site.city}<br />
      {site.hashtag}
    </footer>
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
