---
import type { ImageMetadata } from 'astro';
import site from '../data/site.json';
import { url } from '../lib/url';
import Countdown from './Countdown.astro';
import KolamDivider from './KolamDivider.astro';
import FloralCluster from './FloralCluster.astro';

// Photos in src/assets/hero/ become a cross-fading slideshow behind the names.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const slides = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);
---
<section class:list={['hero', { 'hero--photo': slides.length > 0 }]}>
  {slides.length > 0 && (
    <div class="slides" data-slideshow>
      {slides.map((img, i) => <img src={img.src} alt="" class:list={{ active: i === 0 }} />)}
    </div>
  )}
  <div class="petals" data-petals aria-hidden="true"></div>
  <div class="decor decor-tl" data-parallax="0.18"><FloralCluster class="floral" /></div>
  <div class="decor decor-br" data-parallax="-0.12"><FloralCluster class="floral floral-alt" /></div>

  <div class="inner">
    <p class="invocation" lang="kn" data-reveal>{site.invocation}</p>
    <p class="blessing" lang="kn" data-reveal style="--delay:0.15s">{site.blessing}</p>

    <div class="ring-wrap">
      <svg class="ring" viewBox="0 0 200 200" data-reveal="draw" aria-hidden="true">
        <circle class="draw" pathLength="1" cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1.2" transform="rotate(-90 100 100)" />
        <circle class="draw" pathLength="1" cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="1 3" style="--delay:0.6s" />
      </svg>
      <h1 class="names script" data-reveal="zoom" style="--delay:0.3s">
        <span>{site.partner1.en}</span>
        <span class="amp">&amp;</span>
        <span>{site.partner2.en}</span>
      </h1>
    </div>
    <p class="names-kn" lang="kn" data-reveal style="--delay:0.5s">{site.partner1.kn} ಮತ್ತು {site.partner2.kn}</p>

    <KolamDivider />
    <p class="date" data-reveal>{site.dateDisplay}</p>
    <p class="date-kn" lang="kn" data-reveal style="--delay:0.1s">{site.dateDisplayKn}</p>
    <p class="city" data-reveal style="--delay:0.2s">{site.city}</p>
    <div data-reveal style="--delay:0.3s"><Countdown /></div>
    <a class="button" href={url('rsvp')} data-reveal style="--delay:0.4s">RSVP</a>
  </div>
  <a class="scroll-cue" href="#home-bands" aria-label="Scroll down">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 9l7 7 7-7" /></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 3.2rem);
    display: grid;
    place-items: center;
    text-align: center;
    padding: 3rem 1rem 5rem;
    background-image: var(--bg-hero-image);
    background-size: cover;
    background-position: center;
  }
  .inner { position: relative; z-index: 2; max-width: 44rem; }
  .petals { position: absolute; inset: 0; z-index: 3; overflow: hidden; pointer-events: none; }

  .decor { position: absolute; z-index: 1; width: clamp(9rem, 26vw, 20rem); pointer-events: none; }
  .decor-tl { top: -2rem; left: -3rem; }
  .decor-br { bottom: -3rem; right: -3rem; }
  .decor :global(.floral) { width: 100%; height: auto; animation: drift 9s ease-in-out infinite alternate; }
  .decor :global(.floral-alt) { animation-duration: 11s; animation-direction: alternate-reverse; }

  .invocation { font-size: 0.95rem; color: var(--color-muted); margin: 0; }
  .blessing { font-size: 1.5rem; color: var(--color-gold); margin: 0.4rem 0 0; }

  .ring-wrap { position: relative; display: grid; place-items: center; margin: 0.5rem auto 0; width: min(78vw, 24rem); aspect-ratio: 1; }
  .ring { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--color-gold); }
  .names {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: clamp(2.8rem, 10vw, 4.8rem);
    line-height: 1.05;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .amp { color: var(--color-gold); font-size: 0.7em; }
  .names-kn { font-size: 1.3rem; margin: 0.25rem 0 0; }
  .date { font-size: 1.5rem; margin: 0; letter-spacing: 0.04em; }
  .date-kn { margin: 0.2rem 0 0; color: var(--color-muted); }
  .city { font-family: var(--font-ui); font-size: 0.8rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-muted); }

  .scroll-cue {
    position: absolute; bottom: 1.25rem; left: 50%; translate: -50% 0; z-index: 2;
    color: var(--color-gold); animation: bob 2.2s ease-in-out infinite;
  }

  /* Slideshow version (when photos exist in src/assets/hero/) */
  .slides { position: absolute; inset: 0; z-index: 0; }
  .slides img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transform: scale(1.08);
    transition: opacity 2s ease, transform 8s ease-out;
  }
  .slides img.active { opacity: 1; transform: scale(1); }
  .hero--photo::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, #0005, #0006 60%, #000a);
  }
  .hero--photo .inner, .hero--photo .names, .hero--photo .invocation, .hero--photo .date-kn,
  .hero--photo .city, .hero--photo :global(.countdown small) { color: #fff; }
  .hero--photo :global(.countdown span[data-unit]) { color: #fff; }
</style>
