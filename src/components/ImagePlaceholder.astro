---
// Shown wherever an image hasn't been added yet: a soft watercolour wash with a Kannada/English label.
interface Props { label: string; seed?: number; kn?: boolean }
const { label, seed = 0, kn = false } = Astro.props;
const washes = [
  ['#f6d9a0', '#f3c7c4', '#fbefe0'],
  ['#c9dcc1', '#f6e3c6', '#eef3e8'],
  ['#f3c7c4', '#e6d3ec', '#fbeff0'],
  ['#f9d77e', '#c9dcc1', '#fdf5e1'],
  ['#e6d3ec', '#cfe0e8', '#f4f0f8'],
];
const [a, b, c] = washes[seed % washes.length];
---
<div class="ph" style={`--a:${a};--b:${b};--c:${c}`}>
  <span lang={kn ? 'kn' : undefined}>{label}</span>
</div>
<style>
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    background:
      radial-gradient(60% 70% at 20% 25%, var(--a), transparent 70%),
      radial-gradient(55% 65% at 85% 80%, var(--b), transparent 70%),
      var(--c);
  }
  span { font-size: clamp(1.4rem, 3vw, 2rem); color: #7a5c3a; opacity: 0.8; }
</style>
