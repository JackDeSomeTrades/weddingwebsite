---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Drop photos into src/assets/gallery/ — they appear here automatically (sorted by filename).
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ src: mod.default, alt: path.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ') }));
---
<div class="gallery">
  {photos.length > 0
    ? photos.map((p) => <Image src={p.src} alt={p.alt} widths={[400, 800]} sizes="(max-width: 600px) 100vw, 33vw" />)
    : Array.from({ length: 6 }, () => <div class="placeholder" aria-hidden="true">Photo</div>)}
</div>
<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .gallery :global(img), .placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #f3c7c455, #c9dcc155);
    border: 1px dashed var(--color-line);
    font-family: var(--font-ui);
    color: var(--color-muted);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }
</style>
