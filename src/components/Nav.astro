---
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

interface Props { current: string }
const { current } = Astro.props;

// Tabs are generated from src/content/pages/*.md, sorted by `order`.
const pages = (await getCollection('pages'))
  .filter((p) => p.data.showInNav)
  .sort((a, b) => a.data.order - b.data.order);

const href = (id: string) => (id === 'home' ? url() : url(id));
---
<header class="site-header">
  <nav aria-label="Main">
    <button class="menu-toggle" aria-expanded="false" aria-controls="nav-list">Menu</button>
    <ul id="nav-list">
      {pages.map((p) => (
        <li>
          <a href={href(p.id)} aria-current={p.id === current ? 'page' : undefined}>{p.data.title}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }
  nav { max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
  }
  a {
    display: block;
    padding: 1rem 0.25rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    border-bottom: 2px solid transparent;
  }
  a:hover { color: var(--color-accent); }
  a[aria-current='page'] { color: var(--color-accent); border-bottom-color: var(--color-gold); }
  .menu-toggle { display: none; }

  @media (max-width: 760px) {
    .menu-toggle {
      display: block;
      width: 100%;
      padding: 0.9rem;
      background: none;
      border: 0;
      font-family: var(--font-ui);
      font-size: 0.85rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-text);
      cursor: pointer;
    }
    ul { display: none; flex-direction: column; text-align: center; padding-bottom: 0.75rem; gap: 0; }
    .menu-toggle[aria-expanded='true'] + ul { display: flex; }
    a { padding: 0.6rem; border-bottom: 0; }
  }
</style>
