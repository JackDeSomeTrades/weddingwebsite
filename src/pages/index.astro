---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description} current="home" background={page.data.background}>
  <Hero />
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
